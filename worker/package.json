{
  "name": "kulup-worker",
  "version": "0.3.0",
  "description": "Kulüp etkinlik yönetimi ve kapı uygulaması",
  "author": "Kulup Altyapisi",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-server/index.cjs --external:electron --external:whatsapp-web.js --external:puppeteer --external:puppeteer-core --external:express && esbuild electron/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-electron/main.cjs --external:electron",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepare:chrome:linux": "node scripts/prepare-chrome.mjs --platform=linux",
    "prepare:chrome:win": "node scripts/prepare-chrome.mjs --platform=win",
    "dist": "npm run prepare:chrome:linux && npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run prepare:chrome:win && npm run build && electron-builder --win nsis",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.58.0",
    "puppeteer": "24.38.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "undici": "^7.29.1",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "org.kulup.worker",
    "productName": "Kulüp Worker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": ".puppeteer-cache/chrome/linux-146.0.7680.31",
          "to": ".puppeteer-cache/chrome/linux-146.0.7680.31"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": ".puppeteer-cache/chrome/win-146.0.7680.31",
          "to": ".puppeteer-cache/chrome/win-146.0.7680.31"
        }
      ]
    }
  },
  "allowScripts": {
    "electron@42.11.7": true,
    "puppeteer@24.38.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
