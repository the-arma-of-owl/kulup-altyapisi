# ─── Site (Next.js) Ortam Değişkenleri ───────────────────────────────────────
# Yerelde `.env.local` olarak kopyala; canlıda Vercel → Project → Settings → Environment Variables.
# Kulübün adı, adresleri, renkleri ve sosyal medya hesapları kök dizindeki kulup.config.json'dan gelir.
# Gizli değerler boş bırakıldı; canlıda güçlü, benzersiz değerler kullan (openssl rand -hex 32).

# ─── CMS bağlantısı ──────────────────────────────────────────────────────────
# CMS'in (Payload paneli) adresi. Tarayıcıdan da kullanılır (medya, yönetim bağlantısı).
NEXT_PUBLIC_CMS_URL=http://127.0.0.1:3001
# Sunucu tarafında CMS'e giden istekler için adres (boşsa NEXT_PUBLIC_CMS_URL)
CMS_URL=
# Site ↔ CMS ortak gizli anahtar: formlar CMS'e bu anahtarla iletilir. CMS'teki INTERNAL_API_KEY ile AYNI olmalı.
INTERNAL_API_KEY=
# CMS içerik değişince sitenin önbelleğini yeniler. CMS'teki REVALIDATE_SECRET ile AYNI olmalı.
REVALIDATE_SECRET=

# ─── Adresler (boşsa kulup.config.json) ──────────────────────────────────────
# Sitenin kendi adresi (bağlantı önizlemeleri, sitemap, sertifika bağlantıları)
NEXT_PUBLIC_SITE_URL=
# Medya CDN adresi (R2 önündeki alan adı)
NEXT_PUBLIC_CDN_URL=
# Takım sayfası görselleri için ek izinli kökenler (virgülle), ör. yerelde http://127.0.0.1:3001
NEXT_PUBLIC_TEAM_MEDIA_ORIGINS=
# Analitik olaylarının gönderileceği adres (boşsa CMS'in /api/analytics/collect ucu)
NEXT_PUBLIC_ANALYTICS_URL=

# ─── Bot koruması (Cloudflare Turnstile) ────────────────────────────────────
# Formlar Turnstile ile korunur. Yerelde Cloudflare'in test anahtarları kullanılabilir:
#   site: 1x00000000000000000000AA   gizli: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Takım modu ──────────────────────────────────────────────────────────────
# Katılımcı oturum çerezini imzalar (en az 32 karakter). Yalnız sitede.
PARTICIPANT_SESSION_SECRET=

# ─── Test ortamı ─────────────────────────────────────────────────────────────
# 1 ise: arama motorlarına kapalı + üstte "test ortamı" bandı
NEXT_PUBLIC_BYT_STAGING=
