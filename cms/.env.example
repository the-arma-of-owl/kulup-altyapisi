# ─── Payload CMS Ortam Değişkenleri ──────────────────────────────────────────
# Bu dosyayı `.env` olarak kopyala ve değerleri doldur. `.env` dosyasını ASLA git'e gönderme.
# Kulübün adı, adresleri ve e-posta bilgileri kök dizindeki kulup.config.json'dan gelir;
# aşağıdaki adres değişkenleri tanımlanırsa config'teki değerlerin yerine geçer.
# Gizli değerler boş bırakıldı; canlıda güçlü, benzersiz değerler kullan (openssl rand -hex 32).

# ─── Zorunlu ─────────────────────────────────────────────────────────────────
# Payload oturum/şifreleme anahtarı. En az 32 karakter olmalı.
PAYLOAD_SECRET=
# PostgreSQL bağlantı adresi (canlı). Yerelde (NODE_ENV≠production) SQLite kullanılır.
DATABASE_URL=

# Yerelde SQLite yerine Postgres kullanmak için: PAYLOAD_DB=postgres (DATABASE_URL ile).
# PAYLOAD_PUSH=1 yalnız BOŞ/TEST veritabanında: Payload şemayı koda eşitler ve tanımadığı tabloları SİLER.
# Canlı veritabanında ASLA açma (şema cms/sql/ ile yönetilir).
PAYLOAD_DB=
PAYLOAD_PUSH=

# ─── Adresler ────────────────────────────────────────────────────────────────
# Sitenin adres(ler)i, virgülle ayrılır (CORS/CSRF). İlki bağlantı üretmek için kullanılır. Boşsa: kulup.config.json → adresler.site
NEXT_PUBLIC_FRONTEND_URL=https://kulubum.example.com
# CMS'in (panelin) dış adresi. Boşsa: kulup.config.json → adresler.cms
PAYLOAD_PUBLIC_SERVER_URL=https://panel.kulubum.example.com
# Medya dosyalarının sunulduğu CDN adresi (R2 önünde). Boşsa dosyalar CMS üzerinden sunulur.
NEXT_PUBLIC_CDN_URL=
# Ek izinli kökenler (virgülle ayrılmış), ör. önizleme ortamları
EXTRA_ALLOWED_ORIGINS=
# Takım sayfası görselleri için ek izinli kökenler (virgülle ayrılmış), ör. yerelde http://localhost:3001
NEXT_PUBLIC_TEAM_MEDIA_ORIGINS=

# ─── Cloudflare R2 depolama (canlı) ──────────────────────────────────────────
# R2 S3 uç noktası: https://<hesap-kimliği>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Medya kovası adı
R2_BUCKET=kulup-medya
# R2 erişim anahtarı (gizli)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── E-posta (Resend) ────────────────────────────────────────────────────────
# Resend API anahtarı (gizli)
RESEND_API_KEY=
# Gönderen, "Ad <adres>" biçiminde. Boşsa: kulup.config.json → eposta.gonderenAd / eposta.gonderen
RESEND_FROM=
# İsteğe bağlı: farklı bir Resend uyumlu uç nokta (varsayılan https://api.resend.com/emails)
RESEND_API_URL=
# Günlük / aylık gönderim kotası (raporlarda uyarı için; varsayılan 100 / 3000)
RESEND_DAILY_LIMIT=
RESEND_MONTHLY_LIMIT=
# Katılımcı kod maillerinin gidebileceği adresler (virgülle). Canlıda boşsa herkese gider; geliştirmede kilit.
PARTICIPANT_MAIL_ALLOWLIST=

# ─── İç servis sırları (hepsi gizli) ─────────────────────────────────────────
# Site ve masaüstü worker'ın CMS'e iç anahtarla erişimi. Boşsa iç erişim kapalı.
INTERNAL_API_KEY=
# Siteye önbellek yenileme (revalidate) isteği atarken kullanılan sır; sitedeki değerle aynı olmalı.
REVALIDATE_SECRET=
# Zamanlanmış görevlerin (/api/cron/*) Authorization başlığında beklenen sır
CRON_SECRET=
# İsteğe bağlı: API anahtarı şifreleme sırrı (boşsa PAYLOAD_SECRET; değişirse kayıtlı anahtarlar yeniden girilmeli)
ENCRYPTION_KEY=
# İsteğe bağlı: ziyaretçi istatistikleri günlük tuz sırrı (boşsa PAYLOAD_SECRET)
ANALYTICS_SALT_SECRET=
# İsteğe bağlı: olay günlüğünde IP/e-posta özetleme sırrı (boşsa PAYLOAD_SECRET)
OBS_HASH_SECRET=
# İsteğe bağlı: katılımcı doğrulama kodlarının özet sırrı (boşsa PAYLOAD_SECRET)
PARTICIPANT_CODE_SECRET=

# ─── Telegram bildirimleri ───────────────────────────────────────────────────
# Bot jetonu ve bildirim grubunun sohbet kimliği. Boşsa bildirim gönderilmez.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram webhook isteklerini doğrulayan gizli değer
TELEGRAM_WEBHOOK_SECRET=
# Bot komutlarını (geri yükleme, acil kilit) kullanabilecek kullanıcı kimlikleri (virgülle). Boşsa grup yöneticileri.
TELEGRAM_ADMIN_IDS=
# 1: hiçbir şey gönderilmez, mesajlar konsola yazılır (yerel test)
TELEGRAM_DRY_RUN=
# Forum konuları açıksa varsayılan konu kimliği (message_thread_id)
TELEGRAM_TOPIC_DEFAULT=
# İsteğe bağlı konu kimlikleri; boşsa TELEGRAM_TOPIC_DEFAULT kullanılır
TELEGRAM_TOPIC_APPLICATIONS=
TELEGRAM_TOPIC_SENDS=
TELEGRAM_TOPIC_SECURITY=
TELEGRAM_TOPIC_ERRORS=
TELEGRAM_TOPIC_REPORTS=
TELEGRAM_TOPIC_SYSTEM=

# ─── Seed ve staging ─────────────────────────────────────────────────────────
# Yerel seed'in oluşturduğu yönetici hesabı (varsayılan admin@example.invalid)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# 1: staging ortamı (gerçek kişilere mail gitmez, staging seed'i çalışabilir)
BYT_STAGING=
# Staging'de mail gidebilecek adresler (virgülle)
STAGING_MAIL_ALLOWLIST=
# Staging seed'inin yazabileceği veritabanı host'ları ve Supabase proje kimlikleri (virgülle)
STAGING_DATABASE_HOSTS=
STAGING_DATABASE_PROJECTS=

# NODE_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_BRANCH_URL: çalışma ortamı/Vercel tarafından otomatik verilir.
