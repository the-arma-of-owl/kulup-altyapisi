{
  "name": "cms",
  "version": "1.0.0",
  "description": "Kulüp CMS - Payload 3.0 on Vercel",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload generate:importmap && next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "npm run seed:local",
    "seed:local": "tsx src/seed-local.ts",
    "seed:demo": "tsx src/seed-demo-siber.ts",
    "seed:prod": "tsx src/seed-prod.ts",
    "seed:staging": "tsx src/seed-staging.ts --yes-staging",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.0",
    "@payloadcms/db-sqlite": "3.90.0",
    "@payloadcms/next": "3.90.0",
    "@payloadcms/richtext-lexical": "3.90.0",
    "@payloadcms/storage-s3": "3.90.0",
    "@payloadcms/ui": "3.90.0",
    "@types/pg": "^8.20.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "drizzle-orm": "^0.45.2",
    "file-type": "21.3.4",
    "graphql": "^16.8.1",
    "next": "16.4.2",
    "payload": "3.90.0",
    "payload-totp": "3.0.3",
    "pg": "^8.20.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.5",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "payload>undici": "7.29.1"
    }
  }
}
